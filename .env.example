# PostgreSQL connection
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=rag_db
PG_USER=postgres
PG_PASSWORD=postgres
# Optional: name of the vector collection/table namespace
PG_COLLECTION=pdf_rag

# Hugging Face
# Required for HuggingFaceEndpoint and embeddings download
HUGGINGFACEHUB_API_TOKEN=your_hf_token_here
# LLM repo id to use for generation
HF_LLM_REPO_ID=HuggingFaceH4/zephyr-7b-beta
# Embedding model repo id
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
